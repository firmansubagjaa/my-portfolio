{
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"useImportType": "warn"
			},
			"a11y": {
				"useAltText": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"lineWidth": 100,
		"formatWithErrors": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"parser": {
			"jsxEverywhere": true
		}
	}
}
